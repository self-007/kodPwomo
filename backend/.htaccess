# Hostinger - Activer mod_rewrite
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Options importantes pour Hostinger
    Options +FollowSymLinks -Indexes -MultiViews
    
    # Enlever le trailing slash
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)/$ /$1 [L,R=301]
    
    # Si le fichier ou dossier existe physiquement, ne pas réécrire
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    
    # Rediriger tout vers index.php
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

# Si mod_rewrite n'est pas disponible
<IfModule !mod_rewrite.c>
    # Bloquer l'accès direct (fallback)
    <FilesMatch "\.(php)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
    <FilesMatch "^(index\.php)$">
        Order allow,deny
        Allow from all
    </FilesMatch>
</IfModule>